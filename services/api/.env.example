# services/api/.env.example
# Copia este archivo a .env y completa los valores reales. NUNCA commitees .env.

ENVIRONMENT="development"

DATABASE_URL="postgresql+asyncpg://usuario:password@localhost:5432/sentra"

# Genera uno real con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="changeme"

# Lemon Squeezy (Merchant of Record — no requiere RUC/empresa propia).
# Dashboard > Settings > API para la API key; Store ID en Settings > Stores;
# Variant ID en el producto/plan Pro; Webhook secret al crear el webhook
# en Settings > Webhooks. Para probarlo en local, expón el puerto 8000 con
# un túnel (ngrok/cloudflared) y apunta el webhook a esa URL pública.
LEMONSQUEEZY_API_KEY="changeme"
LEMONSQUEEZY_STORE_ID="changeme"
LEMONSQUEEZY_VARIANT_ID_PRO="changeme"
LEMONSQUEEZY_WEBHOOK_SECRET="changeme"

REDIS_URL="redis://localhost:6379/0"

COOKIE_DOMAIN=".cescjavier.dev"

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

node_modules
.next
.env
.DS_Store

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Seguridad estricta para variables de entorno
.env.local
.env.development
.env.production
# Excepción: los .env.example son plantillas sin secretos, sí deben ir a git
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Backend Python (services/api): el entorno virtual y artefactos de instalación
# NUNCA van a git — se instalan en el build de Docker (pip install). Los binarios
# compilados en macOS no sirven en el Linux del VPS, y son miles de archivos.
services/api/venv/
services/api/get-pip.py
__pycache__/
*.pyc
services/api/**/__pycache__/

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Tabla para identificar a cada visitante único del chat
model ChatSession {
  id             String    @id @default(uuid())
  ipAddress      String?
  startedAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  humanOverride  Boolean   @default(false) // El interruptor mágico para que tú tomes el control
  
  messages       Message[]
}

// 2. Tabla para guardar el historial exacto de la conversación
model Message {
  id            String       @id @default(uuid())
  sessionId     String
  role          Role         // 'user' (reclutador), 'ai' (MekaSenku), o 'admin' (Tú)
  content       String
  createdAt     DateTime     @default(now())

  session       ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  AI
  ADMIN
}